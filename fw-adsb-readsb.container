# ADS-B readsb decoder quadlet (rootless podman, user-level systemd unit)
# Feature: fw-gsd specs/003-usb-adsb-feeder (T009)

[Unit]
Description=Flight Wall ADS-B readsb decoder
After=network-online.target
Wants=network-online.target

[Container]
# Pinned to SemVer tag + SHA256 digest. Dependabot tracks the
# Containerfile.adsb-readsb sentinel and the digest-sync check keeps this
# line identical to it, mirroring the Containerfile.fw-app sentinel
# convention (see fw-app.container).
Image=ghcr.io/tempest-concorde/fw-adsb-readsb:v2.2.16@sha256:e309858b7d00114f870cee8b74e80038f039e39cac28e6eebb8a5e6f746de939
ContainerName=fw-adsb-readsb
Pull=newer
RunInit=true

# RTL-SDR receiver via the stable udev symlink (not /dev/bus/usb — that path
# varies across hot-plug). Rootless AddDevice fails container start when the
# node is absent; fw-adsb-readsb-restart.path re-fires on replug.
AddDevice=/dev/radio-adsb/rtl-sdr0

# JSON output dir (aircraft.json etc.); docroot + data symlink baked into image.
Volume=fw-adsb-readsb-data:/readsb:z

# Internal ADS-B service network (DNS: fr24feed reaches us as fw-adsb-readsb:30005).
Network=fw-adsb.network

# SELinux labels (shared volume context)
SecurityLabelLevel=s0

# HTTP JSON + raw protocol streams. Default is LOOPBACK-only (T041 / FR-005):
# until fw-adsb-tailnet-bind runs, the ports are unreachable from the LAN —
# the safe pre-bind state. Its drop-ins reset this list and rebind each port
# to the host's tailscale IPv4 (VERIFY-on-hardware).
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:30003:30003
PublishPort=127.0.0.1:30005:30005

[Service]
Restart=always
RestartSec=10
# Extend startup timeout for image pull on first boot.
TimeoutStartSec=300

[Install]
WantedBy=default.target
