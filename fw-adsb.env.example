# ADS-B / flightradar24 feed configuration — deployment values
# Feature: fw-gsd specs/003-usb-adsb-feeder (T006; contract: contracts/configuration.md)
#
# Copy to /etc/fw-os/fw-adsb.env and set deployment-specific values (0640, root:core).
# This file MUST NOT contain secret material — the FR24 sharing key is a podman
# secret named `fr24-sharing-key`, never referenced by value here.

# Enable/disable the upstream push to flightradar24. Local pull via the readsb
# container keeps working regardless (spec FR-007/FR-014).
FW_FR24_ENABLED=false

# Path (inside the fr24feed container) where the sharing-key secret is mounted.
# Default matches the Secret= line in fw-adsb-fr24feed.container.
FW_FR24_SHARING_KEY_FILE=/run/secrets/fr24-sharing-key

# Display name registered for this radar on FR24. Defaults to the host hostname
# when left empty.
FW_FR24_STATION_NAME=

# Station position (optional). Required only when MLAT (multilateration) is
# enabled below; leave unset to run a position-less (radar-only) feed.
# Latitude/longitude in decimal degrees, elevation in metres AMSL.
# Constraints (spec FR-012, data-model): -90<=LAT<=90, -180<=LON<=180.
FW_FR24_LAT=
FW_FR24_LON=
FW_FR24_ELEV=

# Multilateration participation (opt-in — transmits precise station coordinates
# and timing upstream). Forced OFF when any position value above is unset.
FW_FR24_MLAT=false
