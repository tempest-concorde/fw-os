# Flight Wall Application Quadlet
# User-level systemd container unit (rootless podman)

[Unit]
Description=Flight Wall Application
Documentation=https://github.com/tempest-concorde/fw-app
After=network-online.target
Wants=network-online.target

[Container]
# Pinned to SemVer tag + SHA256 digest. The Containerfile.fw-app sentinel
# (same reference) is Dependabot-tracked; the digest-sync workflow keeps this
# Image= line in sync when fw-app is rebuilt.
Image=ghcr.io/tempest-concorde/fw-app:1.0.2@sha256:40af653e8ca2c9a55087f864af36e851d53e21d3a3bd82ec813597ca8c1f2365
ContainerName=fw-app
Pull=newer
RunInit=true

# Application environment
Environment=GIN_MODE=release
Environment=GITHUB_ORG=tempest-concorde
Environment=LED_TILE_W=16
Environment=LED_TILE_H=16
Environment=LED_TILES_X=10
Environment=LED_TILES_Y=2

# Data volume (SQLite database, uploaded images)
Volume=%h/.fw-app/data:/data:z

# FQDN meta file (written host-side by fw-app-secrets.service) + cert material
# read by the in-container `fw-app healthcheck`.
Volume=%h/.fw-app/meta:/run/fw-app/meta:ro
Volume=%h/.fw-app/certs:/run/fw-app/certs:ro

# Hardware access - LED matrix via GPIO
# gpiochip devices are the standard interface on modern kernels
# gpiomem is legacy and may not exist on all RPi4 kernel builds
AddDevice=/dev/gpiochip0
AddDevice=/dev/gpiochip1

# SELinux labels (shared volume context)
SecurityLabelLevel=s0

# Network - bind to localhost only on the host; container serves TLS on 8443
# and the host publishes 127.0.0.1:443 -> 8443 (unprivileged-port sysctl baked
# into the image allows the low host port).
PublishPort=127.0.0.1:443:8443

# Startup
TimeoutStartSec=300
# Wait for the system-level secret provisioning oneshot to finish before
# starting. (A user quadlet cannot Requires= a system unit directly.)
ExecStartPre=/usr/libexec/fw-os/wait-for-fw-secrets.sh

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target