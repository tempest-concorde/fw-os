[Unit]
Description=Provision fw-app secrets and TLS certs (first-boot ordering)
Documentation=https://github.com/tempest-concorde/fw-os
After=network-online.target tailscaled.service user@1000.service
Wants=network-online.target

[Service]
Type=oneshot
User=core
Group=core
ExecStart=/usr/libexec/fw-os/fw-app-secrets.sh
StandardOutput=journal
StandardError=journal
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target