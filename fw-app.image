# Flight Wall Application Image
# Quadlet image unit — pre-pulls fw-app container on boot

[Image]
# Pinned to SemVer tag + SHA256 digest. Kept in sync with fw-app.container
# and the Containerfile.fw-app sentinel by the digest-sync workflow.
Image=ghcr.io/tempest-concorde/fw-app:1.0.2@sha256:40af653e8ca2c9a55087f864af36e851d53e21d3a3bd82ec813597ca8c1f2365

[Service]
TimeoutStartSec=300

[Install]
WantedBy=default.target
