# fw-adsb-status image — feature fw-gsd specs/003-usb-adsb-feeder (T008)
# First-party Go status aggregator; stdlib-only, no third-party modules.

# TODO(release): digest-pin builder base before release
FROM docker.io/library/golang:1.25 AS builder
WORKDIR /src
COPY src/ ./
RUN GOFLAGS=-trimpath CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/fw-adsb-status ./cmd/fw-adsb-status

# TODO(release): digest-pin runtime base before release
FROM quay.io/fedora/fedora-minimal:42
COPY --from=builder /out/fw-adsb-status /usr/local/bin/fw-adsb-status

USER 1001
EXPOSE 8081

ENTRYPOINT ["/usr/local/bin/fw-adsb-status"]

