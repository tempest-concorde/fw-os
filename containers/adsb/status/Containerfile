# fw-adsb-status image — feature fw-gsd specs/003-usb-adsb-feeder (T008, T039)
# First-party Go status aggregator; stdlib-only, no third-party modules.
#
# Digest pins (T039, resolved 2026-09-26 via Docker Hub API; arm64 verified).

# Go builder: Red Hat hardened Go 1.27 image, digest-pinned (T010, fw-gsd
# specs/004-fedora-version-alignment). src/go.mod deliberately still declares
# `go 1.25` — no directive change needed because a 1.27 toolchain correctly
# builds a `go 1.25` module (builder is newer than the language directive).
FROM registry.access.redhat.com/hi/go:1.27@sha256:cf54e1f8345bd38401ca8b651b4b0db65c784c23d4ab2b03f97d08a1d8bbbde4 AS builder
WORKDIR /src
COPY src/ ./
RUN GOFLAGS=-trimpath CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/fw-adsb-status ./cmd/fw-adsb-status

FROM docker.io/library/fedora:46@sha256:a9bab18d01cf2c2cf62f3e79c72623405bce14ac062995cc6651a3073c802e41
COPY --from=builder /out/fw-adsb-status /usr/local/bin/fw-adsb-status

USER 1001
EXPOSE 8081

ENTRYPOINT ["/usr/local/bin/fw-adsb-status"]

