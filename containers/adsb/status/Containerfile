# fw-adsb-status image — feature fw-gsd specs/003-usb-adsb-feeder (T008, T039)
# First-party Go status aggregator; stdlib-only, no third-party modules.
#
# Digest pins (T039, resolved 2026-09-26 via Docker Hub API; arm64 verified).

# Go builder: Red Hat hardened Go 1.27 image, digest-pinned (T010, fw-gsd
# specs/004-fedora-version-alignment). src/go.mod declares `go 1.26` — the
# minimum is pinned at 1.26.9 exactly (GO-2026-6617 net/http HPACK encoder race;
# govulncheck on the 1.25 line fails CI; builder 1.27 builds it either way).
# Build context is the REPOSITORY ROOT (see readsb/Containerfile for the
# rationale), so source paths below are repo-relative.
FROM registry.access.redhat.com/hi/go:1.27@sha256:272f0bce0fbc8d8756c275538de3024059d648f2f1553ed3b63beeda992128e4 AS builder
WORKDIR /src
COPY containers/adsb/status/src/ ./
RUN GOFLAGS=-trimpath CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/fw-adsb-status ./cmd/fw-adsb-status

FROM docker.io/library/fedora:46@sha256:78bb31de333664aa76c4bf54306791cd294c0bd4fbcfc4346e2286261de544c4
COPY --from=builder /out/fw-adsb-status /usr/local/bin/fw-adsb-status

USER 1001
EXPOSE 8081

ENTRYPOINT ["/usr/local/bin/fw-adsb-status"]

