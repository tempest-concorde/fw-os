# fw-adsb-status image — feature fw-gsd specs/003-usb-adsb-feeder (T008, T039)
# First-party Go status aggregator; stdlib-only, no third-party modules.
#
# Digest pins (T039, resolved 2026-09-26 via Docker Hub API; arm64 verified).

FROM docker.io/library/golang:1.25@sha256:699337d620559a59b4a2bb298ad59611e535d2ee755a34cf2d2a98f37578dc80 AS builder
WORKDIR /src
COPY src/ ./
RUN GOFLAGS=-trimpath CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/fw-adsb-status ./cmd/fw-adsb-status

FROM docker.io/library/fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
COPY --from=builder /out/fw-adsb-status /usr/local/bin/fw-adsb-status

USER 1001
EXPOSE 8081

ENTRYPOINT ["/usr/local/bin/fw-adsb-status"]

