# fr24feed official client image — feature fw-gsd specs/003-usb-adsb-feeder (T010, T042)
# Third-party binary, version+SHA256 pinned via containers/adsb/versions.env
# (passed as build args by .github/workflows/adsb-images.yml).
#
# PENDING-T039-CRITICAL: FROM bases below intentionally carry floating tags
# until a connected-network pinning pass replaces each with
# tag@sha256:<resolved>. The digest-pin guard job in
# .github/workflows/adsb-images.yml enforces this before release.

# ARG FROM_DIGEST=  # TODO(T039): pin quay.io/fedora/fedora-minimal:42 by digest
FROM quay.io/fedora/fedora-minimal:42 AS fr24

ARG FR24_FEED_URL
ARG FR24_FEED_SHA256

# Hard-fail the build until the checksum is pinned — guarantees no unpinned
# release (research.md Decision 2 vendor-integrity guardrail).
RUN [ "${FR24_FEED_SHA256}" != "PENDING" ] \
 || { echo "FR24_FEED_SHA256 must be pinned before building"; exit 1; }

RUN microdnf install -y curl ca-certificates tar gzip && microdnf clean all

RUN curl -fsSL "${FR24_FEED_URL}" -o /tmp/pkg.tgz \
 && echo "${FR24_FEED_SHA256}  /tmp/pkg.tgz" | sha256sum -c - \
 && tar -xzf /tmp/pkg.tgz -C /tmp \
 && install -m 0755 -D "$(find /tmp -type f -name fr24feed | head -n1)" /out/usr/local/bin/fr24feed \
 && rm -rf /tmp/pkg.tgz /tmp

# ---------------------------------------------------------------------------
# mlat-client (T042): enables opt-in FR24 multilateration (spec FR-012 — only
# used when FW_FR24_MLAT=true AND station position is configured). Source-built
# at the pinned tag from containers/adsb/versions.env.
# VERIFY-on-first-build: mlat-client layout/install paths at MLAT_CLIENT_REF —
# adjust install root or entry script name if upstream packaging changed.
# ---------------------------------------------------------------------------
# ARG FROM_DIGEST=  # TODO(T039): pin builder base by digest
FROM quay.io/fedora/fedora-minimal:42 AS mlat-builder

ARG MLAT_CLIENT_REPO
ARG MLAT_CLIENT_REF
RUN microdnf install -y git python3 python3-setuptools ca-certificates \
 && microdnf clean all
RUN git clone --depth 1 --branch "${MLAT_CLIENT_REF}" "${MLAT_CLIENT_REPO}" /tmp/mlat \
 && cd /tmp/mlat \
 && python3 setup.py install --prefix=/usr/local --root=/tmp/mlat-root

# ---------------------------------------------------------------------------
# Final runtime stage: fr24feed binary + mlat-client + entrypoint.
# ---------------------------------------------------------------------------
# ARG FROM_DIGEST=  # TODO(T039): pin runtime base by digest
FROM quay.io/fedora/fedora-minimal:42

# fr24feed spawns mlat-client from PATH (mounted /usr/local/bin) when MLAT is
# enabled in the rendered config.
COPY --from=fr24 /out/usr/local/bin/fr24feed /usr/local/bin/fr24feed
COPY --from=mlat-builder /tmp/mlat-root/usr/local /usr/local
RUN microdnf install -y python3 && microdnf clean all

COPY entrypoint.sh /usr/local/bin/fw-adsb-fr24feed-entrypoint.sh
COPY fr24feed.ini.tmpl /usr/local/share/fw-adsb/fr24feed.ini.tmpl
RUN chmod 0755 /usr/local/bin/fw-adsb-fr24feed-entrypoint.sh

USER 1001

ENTRYPOINT ["/usr/local/bin/fw-adsb-fr24feed-entrypoint.sh"]
