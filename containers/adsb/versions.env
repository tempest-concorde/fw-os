# =============================================================================
# ADS-B feed feature — pinned upstream versions
# Feature: fw-gsd specs/003-usb-adsb-feeder (T002)
# Single source of truth consumed by every Containerfile under containers/adsb/.
# Values here are the ONLY places versions are declared; Containerfiles read
# them via build args in CI (.github/workflows/adsb-images.yml passed them
# through) so Dependabot/digest tooling has one file to bump.
# =============================================================================

# --- readsb decoder (built from source) --------------------------------------
# Checked against upstream on 2026-09-26 via:
#   git ls-remote https://github.com/wiedehopf/readsb.git HEAD
READSB_REPO=https://github.com/wiedehopf/readsb.git
READSB_COMMIT=3b5368a195e7006a98c428d05560b0b4baffd2ed

# --- fr24feed official client (third-party binary) ----------------------------
# PENDING-VERIFICATION: repo-feed.flightradar24.com is unreachable from the
# implementation sandbox (proxy 403), so the exact upstream latest version + a
# locally-computed SHA256 could not be captured. The canonical artifact pattern
# (from FR24's official Linux install docs) is:
#   https://repo-feed.flightradar24.com/linux_fr24feed_packages/flightradar24_<VERSION>_arm64.tgz
#
# Before first image build on a connected network:
#   1. Query the repo dir listing for the newest arm64 tgz version.
#   2. Download it, run:  sha256sum flightradar24_<VERSION>_arm64.tgz
#   3. Fill FR24_FEED_SHA256 below. The Containerfile hard-fails the build if
#      the checksum stays PENDING — this guarantees no unpinned release.
FR24_FEED_VERSION=1.0.54-1
FR24_FEED_SHA256=PENDING
FR24_FEED_URL=https://repo-feed.flightradar24.com/linux_fr24feed_packages/flightradar24_1.0.54-1_arm64.tgz

# --- mlat-client (FR24 multilateration helper, optional MLAT support) --------
# GitHub: mutability/mlat-client (packaged release tarball)
# PENDING-VERIFICATION: resolve newest tag on a connected network before build;
# pin tag V0.2.13 (widely deployed upstream release) as the target.
MLAT_CLIENT_REPO=https://github.com/mutability/mlat-client
MLAT_CLIENT_REF=v0.2.13
